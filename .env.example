# Nome a dominio pubblico gestito dal tuo reverse proxy (senza https://)
G7_DOMAIN=glicemie.example.com

# Porta su cui il server ascolta, solo su 127.0.0.1: il reverse proxy inoltra qui
G7_PORT=8080

# Facoltativo ma consigliato: segreto di almeno 32 caratteri mescolato a ogni password.
# Chi ruba solo il database non può provare a indovinare le password senza questo valore.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ATTENZIONE: se lo cambi o lo perdi, tutte le password vanno reimpostate.
G7_PEPPER=
