{
  "name": "g7monitor-server",
  "version": "0.1.0",
  "private": true,
  "description": "Server per G7 Monitor: riceve le glicemie dall'app Android e le mostra in un'interfaccia web",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "user": "node src/cli.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
